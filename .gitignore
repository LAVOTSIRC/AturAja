# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# VS Code related
# (Keeping this commented out means .vscode/ IS tracked by default, which is
# handy for sharing debug/run configurations with collaborators. Uncomment
# the line below if your team prefers to keep editor settings out of git.)
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/
/coverage/

# NOTE: pubspec.lock is intentionally NOT ignored. For Flutter *applications*
# (unlike packages/plugins) it should be committed so every collaborator and
# CI build resolves the exact same dependency versions.

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Local configuration files that vary per machine/collaborator.
# (Android/iOS already have their own nested .gitignore for local.properties,
# key.properties, keystores, Pods, etc. These extra root-level rules are just
# a safety net in case any of these end up at the project root.)
local.properties
key.properties
**/*.keystore
**/*.jks
*.p12

# Secrets / environment files (add your own as the project grows).
.env
.env.*
*.env

# Desktop platform build artifacts (safe to keep even before these platforms
# are added to the project, in case a collaborator later runs
# `flutter create .` to enable Windows/macOS/Linux support).
/windows/flutter/ephemeral/
/windows/flutter/generated_plugin_registrant.cc
/windows/flutter/generated_plugin_registrant.h
/windows/flutter/generated_plugins.cmake
/macos/Flutter/ephemeral/
/macos/Flutter/GeneratedPluginRegistrant.swift
/linux/flutter/ephemeral/
/linux/flutter/generated_plugin_registrant.cc
/linux/flutter/generated_plugin_registrant.h
/linux/flutter/generated_plugins.cmake

nul
